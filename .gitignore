# 依赖与构建产物
node_modules/
dist/
*.tsbuildinfo

# 环境变量（含 Polymarket 私钥，严禁上传）
.env
.env.local
.env.*.local

# 运行日志
logs/
*.log

# 系统文件
.DS_Store
Thumbs.db

# 运行时数据（大体积，不入库）
*.tmp

# tsc 编译产物（源码是 TypeScript，.js/.js.map 不入库）
*.js.map
src/**/*.js

# 打包与临时文件
*.zip
*.tar
tmp-grid/

# 运行时数据（账本/回测/快照不入库；price-history 已跟踪，保留）
data/trades-*.json
data/backtest/
data/backup/
data/local-history/
data/server-redis-export.json
data/markets/
data/processed/
data/predictions.json
