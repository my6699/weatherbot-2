# ==================== 运行环境 ====================

# 当前运行环境。
# development：本地开发，日志更详细。
# production：VPS 正式运行，日志更克制。
NODE_ENV=development

# 交易模式。
# paper：模拟交易，只记录决策，不真实下单，推荐新系统先用这个。
# live：真实交易，会调用 Polymarket 下单接口，只有充分验证后再开启。
# 注意：即使 TRADING_MODE=live，还必须同时配置 POLYMARKET_PRIVATE_KEY +
# POLYMARKET_FUNDER_ADDRESS 两个密钥，否则保持 paper 行为（缺密钥绝不真实下单）。
TRADING_MODE=paper

# 当前默认城市。
# 第一版只做上海，所以这里填 shanghai。
DEFAULT_CITY=shanghai


# ==================== Redis 缓存 ====================

# Redis 连接地址。
# DataHub 会把天气预测、概率分布、数据新鲜度写进 Redis。
# StrategyInstance 只从 Redis 读数据，避免每个策略都重复拉天气接口。
REDIS_URL=redis://127.0.0.1:6379

# Redis key 前缀。
# 例如最终 key 会类似：weather:shanghai:d3。
# 用前缀可以避免多个项目共用 Redis 时互相污染。
REDIS_KEY_PREFIX=weather

# 数据最大允许延迟，单位：秒。
# 如果策略发现 Redis 里的天气数据超过 1 小时没更新，就暂停开仓并告警。
DATA_MAX_AGE_SECONDS=3600


# ==================== DataHub 拉取频率 ====================

# DataHub 拉取天气数据的间隔，单位：秒。
# 3600 表示每 1 小时拉一次全量天气数据。
DATAHUB_POLL_INTERVAL_SECONDS=3600

# 数据源连续失败多少次后降权。
# 例如 Open-Meteo 连续失败 3 次，就暂时降低它在概率模型里的贡献。
DATA_SOURCE_FAILURE_THRESHOLD=3


# ==================== 集合预报（ensemble） ====================

# 是否启用集合预报概率接入。
# true：DataHub 额外拉取集合成员，用 KDE 核密度算桶概率，再与原本的高斯概率加权融合。
#       相比"单点预报 + 高斯拟合"，集合分布保留真实不确定性（偏态/多峰），尾部概率更准。
# false：沿用纯高斯拟合（默认，不改变现有行为）。
# 注意：ensemble API（ensemble-api.open-meteo.com）计入 Open-Meteo 每日 1 万次免费配额。
ENSEMBLE_ENABLED=false

# 集合模型名。open-meteo ensemble API 支持：
#   ecmwf_ifs025：ECMWF IFS 集合（51 成员，公认中期预报最准，推荐）
#   gfs025：GFS 集合（31 成员）
#   icon_seamless：ICON 集合（40 成员）
ENSEMBLE_MODEL=ecmwf_ifs025

# 融合权重（0-1）。最终桶概率 = (1-w)×高斯 + w×集合KDE。
# 0.5 表示高斯与集合各占一半；1 = 完全用集合；0 = 完全用高斯。
ENSEMBLE_WEIGHT=0.5

# 是否对集合成员应用该城市 ecmwf 温度档偏差平移（与确定性源同口径的偏差校正）。
ENSEMBLE_BIAS_CORRECT=true

# 实际使用成员数上限（0 = 全部）。请求体积大、或想省配额时抽样降载。
ENSEMBLE_MAX_MEMBERS=0


# ==================== Polymarket ====================

# Polymarket CLOB API 地址。
# CLOB 是 central limit order book，意思是订单簿交易接口。
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com

# Polymarket Gamma API 地址。
# Gamma API 常用于读取市场、事件、slug、token 等公开信息。
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com

# 钱包私钥。
# paper 模式不需要填写。
# live 模式才需要真实私钥。不要把真实私钥提交到 GitHub。
# 用 viem privateKeyToAccount 派生出金钱包，配合 POLY_PROXY 签名给代理钱包下单。
POLYMARKET_PRIVATE_KEY=

# Polymarket funder 地址。
# 某些 CLOB SDK 下单时需要这个地址。paper 模式可留空。
# 就是 Polymarket 页面右上角钱包地址（代理钱包，需要 USDC 授权 CLOB）。
POLYMARKET_FUNDER_ADDRESS=

# Polymarket 签名类型。
# 不确定时先保持 0（POLY_PROXY，最常用）；1 是 POLY_HYBRID。
POLYMARKET_SIGNATURE_TYPE=0

# 链 ID。137 = Polygon 主网（生产），80002 = Amoy 测试网（验证用）。
POLYMARKET_CHAIN_ID=137

# 可选：直接提供 CLOB API key（不填则启动时用钱包自动派生 createOrDeriveApiKey）。
# 三个必须同时填才生效。
#POLYMARKET_CLOB_API_KEY=
#POLYMARKET_CLOB_API_SECRET=
#POLYMARKET_CLOB_API_PASSPHRASE=

# maker 优先执行开关。true：限价 post-only 单先挂（挂对手价等成交，省费控滑点），
# 轮询 POLYMARKET_MAKER_WAIT_MS 未成交则撤单回退市价单；false：直接市价单。
POLYMARKET_MAKER_MODE=true

# 市价单类型。FAK（部分成交，未成交部分撤销）默认；FOK（全成或全撤）。
POLYMARKET_ENTRY_ORDER_TYPE=FAK
POLYMARKET_EXIT_ORDER_TYPE=FAK

# maker 单等待与轮询间隔（毫秒）。
POLYMARKET_MAKER_WAIT_MS=8000
POLYMARKET_MAKER_POLL_MS=1500


# ==================== 风控参数 ====================

# 单次交易最大投入金额，单位：美元。
# paper 模式也会用这个值模拟仓位，防止策略给出过大的买入建议。
# 2026-08-11：模拟总资金 1000U → 每笔 25U（1000U ÷ 40 笔最大并发）。
MAX_POSITION_USD=25

# 单个城市最大总风险敞口，单位：美元。
# 上海策略所有未平仓仓位合计不能超过这个值。
# 2026-08-11：随单笔上调，每城上限 100U。
MAX_CITY_EXPOSURE_USD=100

# 是否允许开 NO 仓位。
# false：第一版只做 YES，更简单。
# true：允许策略在条件满足时买 NO。
ENABLE_NO_TRADES=false

# 硬性清仓时间，上海本地时间。
# 你的策略要求绝不持仓到下午或结算，所以 14:00 前全部平仓。
HARD_EXIT_LOCAL_TIME=14:00


# ==================== 日志 ====================

# 日志等级。
# debug：最详细，适合排查。
# info：正常运行。
# warn：只看警告和错误。
# error：只看错误。
LOG_LEVEL=info

# 日志目录。
# winston 会把 DataHub 和 StrategyInstance 的运行日志写到这里。
LOG_DIR=logs


# ==================== 企业微信通知 ====================

# 企业微信群机器人 Webhook URL。
# 在 https://work.weixin.qq.com/api/doc/90000/90136/91770 创建群机器人后获取。
# 每天 1000 条免费额度，用于接收每日结算报告。
# 不配置则跳过通知，不影响策略运行。
# 格式：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxx
WECOM_WEBHOOK_URL=
