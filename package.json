{
  "name": "polymarket-shanghai-weather-bot",
  "version": "0.1.0",
  "description": "Polymarket 上海 ZSPD 日最高温度预测市场量化交易系统",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:datahub": "tsx src/data/DataHubService.ts",
    "dev:strategy": "tsx src/strategies/MultiCityStrategy.ts",
    "build": "tsc -p tsconfig.json",
    "start:datahub": "node dist/data/DataHubService.js",
    "start:strategy": "node dist/strategies/MultiCityStrategy.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@polymarket/clob-client": "^5.8.1",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "undici": "^8.10.0",
    "viem": "^2.55.13",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "pm2": "^5.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild": true
  }
}
